{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blok",
  "version": "0.9.30",
  "identifier": "2303",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "$blok",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob:; connect-src 'self' https: wss:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "headerImage": "./nsis-res/header.bmp",
        "sidebarImage": "./nsis-res/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MDMyRjRGNjQyOUFGQTEKUldTaHJ5bGtUeThER0JxM3RBM1k3S1p0YnZJVGYvVEp4cW1XZTBWbnRCM1pZUWNMd1VXb3NNY00K",
      "endpoints": [
        "https://github.com/pompei1i/blok-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
