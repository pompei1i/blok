{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "$blok",
  "version": "0.2.12",
  "identifier": "2303",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "$blok",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob:; connect-src 'self' https: wss:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "./nsis-res/header.bmp",
        "sidebarImage": "./nsis-res/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QTY5OUUxQ0JGMDRBOEQKUldTTlN2REw0Wm1tWnZpUkhzYS9sbGU4MzBBMEh5TWtXVVJwK25UalBEZ0JKY1g3Q0gxZHNyL3oK",
      "endpoints": [
        "https://github.com/pompei1i/blok/releases/latest/download/latest.json"
      ]
    }
  }
}
