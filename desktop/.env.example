# Copy to .env.local and fill in. Everything here is baked into the client at build
# time, so only values that are safe to ship in a public binary belong in this file.
# Anything secret (Anthropic/Gemini keys, Cloudflare TURN tokens) lives server-side as
# a Supabase Edge Function secret — see docs/SELF_HOSTING.md.

# ── Required ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optional ──────────────────────────────────────────────────────────────────
# GIF search in the message composer. https://developers.google.com/tenor
VITE_TENOR_API_KEY=

# Static TURN fallback for screen share / video across strict NATs. Normally you do
# NOT set these: the `turn` Edge Function mints short-lived Cloudflare credentials at
# runtime. Use them only when self-hosting coturn (see infra/coturn/).
# VITE_TURN_URLS=turn:host:3478,turns:host:5349?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
